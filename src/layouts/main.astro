---
import '@/styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  url?: string;
  type?: string;
  noindex?: boolean;
}

const {
  title,
  description = "Artículos y videos en español sobre agentes, automatización y el costo real de operar IA en un negocio.",
  image = "/projects/paragraph.png",
  url = Astro.url.href,
  type = "website",
  noindex = false,
} = Astro.props;

// El título se pasa verbatim desde cada página (ya incluye "— Poul Lorca").
const siteTitle = title;
const fullImageUrl = new URL(image, Astro.site).href;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/paragraph.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Primary Meta -->
    <title>{siteTitle}</title>
    <meta name="title" content={siteTitle} />
    <meta name="description" content={description} />
    <meta name="author" content="Poul Lorca" />
    <meta name="keywords" content="agentes IA, automatización negocios, costo operar IA, arquitectura software, herramientas IA, español" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullImageUrl} />
    <meta property="og:image:alt" content={`${title} - Poul Lorca`} />
    <meta property="og:site_name" content="Poul Lorca" />
    <meta property="og:locale" content="es_ES" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={url} />
    <meta property="twitter:title" content={siteTitle} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={fullImageUrl} />
    <meta property="twitter:creator" content="@PoulLorca" />

    <!-- Additional Meta Tags -->
    {noindex
      ? <meta name="robots" content="noindex, nofollow" />
      : <meta name="robots" content="index, follow" />}
    <meta name="theme-color" content="#6366f1" />
    <link rel="canonical" href={url} />

    <script is:inline>
      if (localStorage.theme === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
